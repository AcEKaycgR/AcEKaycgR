name: Generate pacman animation

on:
  schedule: # Execute every 12 hours
    - cron: "0 */12 * * *" # At the start of every 12th hour
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  generate:
    permissions:
      contents: write
      pages: write
      id-token: write

    runs-on: ubuntu-latest
    timeout-minutes: 5

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Generate pacman-contribution-graph.svg (light)
        uses: abozanona/pacman-contribution-graph@main
        with:
          github_user_name: ${{ github.repository_owner }}
          output_path: ./dist/pacman-contribution-graph.svg

      - name: Generate pacman-contribution-graph-dark.svg (dark)
        uses: abozanona/pacman-contribution-graph@main
        with:
          github_user_name: ${{ github.repository_owner }}
          output_path: ./dist/pacman-contribution-graph-dark.svg
          color_scheme: dark

      - name: Force update SVGs
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add dist/pacman-contribution-graph.svg dist/pacman-contribution-graph-dark.svg
          git commit -m "Update Pacman animation [skip ci]" || echo "No changes to commit"
          git push origin main --force

      - name: Push to output branch
        uses: crazy-max/ghaction-github-pages@v3.1.0
        with:
          target_branch: output
          build_dir: dist
          keep_history: false
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
